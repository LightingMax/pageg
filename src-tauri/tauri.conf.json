{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pageg",
  "version": "0.2.0",
  "identifier": "com.pageg.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pageg",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "backgroundColor": "#efe6d6",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
